{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["bun", "node", "vitest"],
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "e2b-template/**/*.ts"],
  "exclude": ["src/web/client"]
}
