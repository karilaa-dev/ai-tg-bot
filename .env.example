# Required: Telegram BotFather token.
BOT_TOKEN=123456:replace-me

# Required: E2B API key. The bot uses one persistent custom E2B Base sandbox per Telegram thread.
E2B_API_KEY=replace-me

# Required: OpenRouter fallback/image key.
OPENROUTER_API_KEY=replace-me
# Optional: search fallback, image discovery and page extraction.
# TAVILY_API_KEY=replace-me
# auto prefers Codex when configured; codex and tavily force one provider.
# WEB_SEARCH_PROVIDER=auto
# Codex search uses live web access by default. Set cached for cache-only search.
# CODEX_WEB_SEARCH_MODE=live

# Optional Browser Use Cloud. When configured, profile-backed interactive browser tools,
# direct Telegram screenshot/file delivery are enabled. Office previews use E2B independently.
# One-shot web_extract uses Tavily when its key is configured.
# BROWSER_USE_API_KEY=replace-with-a-long-lived-key
# BROWSER_USE_DEPLOYMENT_ID=ai-tg-bot
# BROWSER_USE_DEFAULT_TIMEOUT_MINUTES=5
# BROWSER_USE_IDLE_TIMEOUT_MS=300000
# BROWSER_USE_API_TIMEOUT_MS=30000
# BROWSER_USE_NAVIGATION_TIMEOUT_MS=45000

# E2B defaults. Change DEPLOYMENT_ID when two bot deployments share one E2B account.
# E2B_TEMPLATE defaults to ai-tg-bot-tools:v<package.json version>. Leave it unset
# to use that version. Run `bun run e2b:release` before deployment; missing images fail.
# Set an exact reference only for testing or rollback.
# E2B_TEMPLATE=ai-tg-bot-tools:v2.0.20
# E2B_DEPLOYMENT_ID=ai-tg-bot
# E2B_REQUEST_TIMEOUT_MS=30000
# Maximum retained immutable E2B snapshots for files without Telegram recovery (2 GiB).
# E2B_FILE_SOURCE_MAX_BYTES=2147483648
# Data-plane budget for Telegram restoration and large E2B file reads/writes.
# TELEGRAM_FILE_RESTORE_TIMEOUT_MS=300000
# TELEGRAM_FILE_RESTORE_CONCURRENCY=4

# Optional runtime config.
# DB_URL=sqlite:./data/bot.db
# PI_CODING_AGENT_DIR=./data/pi
# OptMem stores notes and summaries in DB_URL. Settings below apply to everyone.
# Leave unset to use these original OptMem defaults; override only what you need.
# OPTMEM_WAKE_LINES=96
# OPTMEM_ENTRY_CHARS=280
# OPTMEM_PART_CHARS=20000
# OPTMEM_PART_LINES=500
# Users can only enable/disable their own memory with /memory on or /memory off.
# Optional override for the standard Codex CLI OAuth cache. By default the bot reads
# ~/.codex/auth.json in place. Website device login instead saves to
# PI_CODING_AGENT_DIR/auth.json, which takes precedence on subsequent starts.
# Container deployments must mount the containing directory read-write because token
# refresh atomically replaces auth.json. Do not use a single-file bind mount.
# CODEX_AUTH_FILE=/app/data/codex/auth.json
# MODEL_CONTEXT_TOKENS=128000
# PI_THINKING_LEVEL=medium
# Provider requests have a separate deadline, even with unlimited turns.
# PI_REQUEST_TIMEOUT_MS=900000
# Recovery grace for ownerless turns from deployments before ownership leases.
# LEGACY_TURN_RECOVERY_GRACE_MS=960000
# Agent execution limits default to 0 (unlimited). Set a positive integer to cap one.
# PI_TURN_TIMEOUT_MS=0
# PI_MAX_MODEL_CYCLES=0
# PI_MAX_TOOL_CALLS=0
# PI_MAX_CONSECUTIVE_TOOL_FAILURES=0
# PI_MAX_IDENTICAL_TOOL_FAILURES=0
# THREAD_TITLE_TIMEOUT_MS=30000

# Optional: Codex OAuth-backed primary models. OpenRouter is used only as fallback.
# CODEX_MODEL=gpt-6.1-sol
# CODEX_HELPER_MODEL=gpt-6-luna
# Enable fast mode for Codex requests only; OpenRouter fallback is unaffected.
# CODEX_FAST_MODE=false
# Use encrypted server checkpoints alongside portable Pi summaries for /compact
# and automatic compaction. Set false to use Pi text summaries only.
# CODEX_SERVER_COMPACTION=true

# Optional: OpenRouter models.
# OPENROUTER_MAIN_MODEL=openai/gpt-6.1-sol
# OPENROUTER_HELPER_MODEL=openai/gpt-6-luna
# OPENROUTER_IMAGE_MODEL=openai/gpt-5.4-image-2
# IMAGE_TIMEOUT_MS=300000
# OPENROUTER_TRANSCRIPTION_MODEL=qwen/qwen3-asr-1.7b
# TRANSCRIPTION_TIMEOUT_MS=120000

# Large TXT/CSV lexical retrieval.
# FILE_INLINE_TOKENS=6000

# Sandbox command limits.
# BASH_TIMEOUT_MS=120000
# BASH_MAX_OUTPUT_CHARS=12000

# Telegram and logging behavior.
# DRAFT_UPDATE_MS=0
# ONBOARDING_TIMEZONE_DELAY_MS=2000
# LOG_LEVEL=info

# Optional admin website for conversations, usage, and headless Codex login.
# Runs in the same Bun process as the bot. The proxy must target WEB_PORT.
WEB_ENABLED=false
# Required when WEB_ENABLED=true. Use a long random secret to sign in.
# WEB_ADMIN_TOKEN=
# Use HTTPS at your reverse proxy, preserving Host and X-Forwarded-Proto.
# WEB_HOST=0.0.0.0
# WEB_PORT=3000
# Auto-load attachments up to 5 MiB. Set 0 to require a click for every file.
# WEB_AUTOLOAD_MAX_BYTES=5242880
