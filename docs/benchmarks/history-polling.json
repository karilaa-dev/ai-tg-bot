{
  "benchmark": "scripts/benchmark-history-polling.ts",
  "command": "bun scripts/benchmark-history-polling.ts <checkout> [--polls 40]; set BENCH_POSTGRES_URL for PostgreSQL",
  "environment": {
    "runtime": "bun 1.4.4",
    "os": "Linux-7.0.0-38-generic-x86_64-with-glibc2.43",
    "postgres": "PostgreSQL 18.4 (local disposable instance)",
    "date": "2026-11-10"
  },
  "notes": "Synthetic fixture only. Bytes are JSON response bodies; HTTP headers (an ETag adds about 50 bytes) are not counted. medianMs is server-side repository work plus serialization and, after, hashing.",
