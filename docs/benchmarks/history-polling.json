        "assistantReplyBytes": 6000,
        "toolCallsPerReply": 6,
        "attachments": 16,
        "activeActionId": 61
      },
      "polls": 40,
      "unchangedPoll": {
        "requests": 1,
        "sqlStatements": 10,
        "responseBytes": 170234,
        "messagesReturned": 50,
        "identicalResponses": true,
        "medianMs": 2.9,
        "p95Ms": 5.05,
        "conditionalResponses": false,
        "firstPollTransferredBytes": 170234,
