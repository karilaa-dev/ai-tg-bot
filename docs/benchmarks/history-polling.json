        "messages": 160,
        "assistantReplyBytes": 6000,
        "toolCallsPerReply": 6,
        "attachments": 15,
        "activeActionId": 61,
        "activeActionLoaded": true
      },
      "polls": 40,
      "unchangedPoll": {
        "requests": 2,
        "sqlStatements": 20,
        "responseBytes": 419938,
        "messagesReturned": 100,
        "identicalResponses": true,
        "medianMs": 9.06,
        "p95Ms": 12.2,
        "conditionalResponses": false,
        "firstPollTransferredBytes": 419938,
        "steadyTransferredBytesPerPoll": 419938,
        "steadyNotModifiedPerPoll": 0
      },
      "perMinute": {
        "busyEvery1500ms": {
          "requests": 80,
          "transferredBytes": 16797520
        },
        "idleEvery8000ms": {
          "requests": 15,
