{
  "name": "ai-tg-bot",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json && node dist/scripts/copy-e2b-template-assets.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "live:pi-check": "tsx scripts/live-pi-check.ts",
    "live:pi-image-check": "tsx scripts/live-pi-image-check.ts",
    "live:pi-fallback": "PI_SMOKE_FORCE_OPENROUTER=1 tsx scripts/live-pi-check.ts",
    "live:e2b-check": "tsx scripts/live-e2b-check.ts",
    "live:browser-use-check": "tsx scripts/live-browser-use-check.ts",
    "e2b:template:build": "tsx e2b-template/build.ts",
    "e2b:template:promote": "tsx e2b-template/promote.ts",
    "e2b:template:check": "tsx e2b-template/check.ts",
    "e2b:release": "tsx e2b-template/release.ts"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/runner": "^2.0.3",
    "@tavily/core": "^0.7.7",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "e2b": "2.45.0",
    "grammy": "^1.45.1",
    "parse5": "8.0.1",
    "pg": "^8.23.0",
    "playwright-core": "1.62.1",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bonkers-agency/grammy-test": "^0.1.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
