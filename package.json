{
  "name": "ai-tg-bot",
  "version": "2.1.7",
  "private": true,
  "overrides": {
    "undici": "^8.12.3"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts --web-dev",
    "start": "bun dist/src/main.js",
    "build": "bun --bun tsc -p tsconfig.json && bun dist/scripts/copy-e2b-template-assets.js && bun run build:web",
    "typecheck": "bun --bun tsc --noEmit && bun --bun tsc -p tsconfig.web.json --noEmit",
    "test": "bun node_modules/vitest/vitest.mjs run",
    "test:web:browser": "bun test/web/browser-smoke.ts && bun test/web/chat-browser-smoke.ts --production && bun test/web/chat-polish-browser-smoke.ts --production && bun test/web/chat-read-browser-smoke.ts --production && bun test/web/chat-media-browser-smoke.ts && bun test/web/chat-openui-language-browser-smoke.ts && bun test/web/chat-search-schedules-browser-smoke.ts --production",
    "live:pi-check": "bun scripts/live-pi-check.ts",
    "live:codex-tools-check": "bun scripts/live-codex-tools-check.ts",
    "live:pi-tools-check": "bun scripts/live-pi-tools-check.ts",
    "live:pi-image-check": "bun scripts/live-pi-image-check.ts",
    "live:pi-image-intent-check": "bun scripts/live-pi-image-intent-check.ts",
    "live:pi-fallback": "PI_SMOKE_FORCE_OPENROUTER=1 bun scripts/live-pi-check.ts",
    "live:e2b-check": "bun scripts/live-e2b-check.ts",
    "live:browser-use-check": "bun scripts/live-browser-use-check.ts",
    "e2b:template:build": "bun e2b-template/build.ts",
    "e2b:template:promote": "bun e2b-template/promote.ts",
    "e2b:template:check": "bun e2b-template/check.ts",
    "e2b:release": "bun e2b-template/release.ts",
    "build:web": "bun scripts/build-web.ts",
    "memo": "bun src/memory/optmem/cli.ts"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/runner": "^2.0.3",
    "@openuidev/lang-core": "1.0.2",
    "@openuidev/react-lang": "1.0.2",
    "@tavily/core": "^0.7.14",
    "@unicode/unicode-16.0.0": "2.1.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "e2b": "2.62.0",
    "file-type": "22.2.0",
    "grammy": "^1.46.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "playwright-core": "1.64.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@bonkers-agency/grammy-test": "^0.1.3",
    "@cloudflare/kumo": "^2.16.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.50.0",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4"
}
