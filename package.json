{
  "name": "ai-tg-bot",
  "version": "2.0.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json && node dist/scripts/copy-e2b-template-assets.js && npm run build:web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "live:pi-check": "tsx scripts/live-pi-check.ts",
    "live:pi-image-check": "tsx scripts/live-pi-image-check.ts",
    "live:pi-image-intent-check": "tsx scripts/live-pi-image-intent-check.ts",
    "live:pi-fallback": "PI_SMOKE_FORCE_OPENROUTER=1 tsx scripts/live-pi-check.ts",
    "live:e2b-check": "tsx scripts/live-e2b-check.ts",
    "live:browser-use-check": "tsx scripts/live-browser-use-check.ts",
    "e2b:template:build": "tsx e2b-template/build.ts",
    "e2b:template:promote": "tsx e2b-template/promote.ts",
    "e2b:template:check": "tsx e2b-template/check.ts",
    "e2b:release": "tsx e2b-template/release.ts",
    "build:web": "tsx scripts/build-web.ts"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/runner": "^2.0.3",
    "@tavily/core": "^0.7.8",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "e2b": "2.46.0",
    "file-type": "22.0.2",
    "grammy": "^1.46.0",
    "pg": "^8.23.0",
    "playwright-core": "1.62.1",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bonkers-agency/grammy-test": "^0.1.3",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
