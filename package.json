{
  "name": "ai-tg-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "upgrade:audit": "node dist/scripts/upgrade-audit.js",
    "live:pi-check": "tsx scripts/live-pi-check.ts",
    "live:pi-fallback": "PI_SMOKE_FORCE_OPENROUTER=1 tsx scripts/live-pi-check.ts",
    "live:e2b-check": "tsx scripts/live-e2b-check.ts",
    "live:browser-use-check": "tsx scripts/live-browser-use-check.ts",
    "e2b:template:build": "tsx e2b-template/build.ts",
    "e2b:template:check": "tsx e2b-template/check.ts",
    "e2b:sandboxes:prune-desktop": "tsx scripts/prune-e2b-desktop-sandboxes.ts"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/runner": "^2.0.3",
    "@tavily/core": "^0.7.6",
    "better-sqlite3": "^13.0.1",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "e2b": "2.36.1",
    "fflate": "^0.8.3",
    "grammy": "^1.45.1",
    "parse5": "8.0.1",
    "pg": "^8.22.0",
    "playwright-core": "1.62.1",
    "undici": "^8.9.0",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bonkers-agency/grammy-test": "^0.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
