{
  "name": "ai-tg-bot",
  "version": "2.0.14",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts --web-dev",
    "start": "bun dist/src/main.js",
    "build": "bun --bun tsc -p tsconfig.json && bun dist/scripts/copy-e2b-template-assets.js && bun run build:web",
    "typecheck": "bun --bun tsc --noEmit && bun --bun tsc -p tsconfig.web.json --noEmit",
    "test": "bun node_modules/vitest/vitest.mjs run",
    "live:pi-check": "bun scripts/live-pi-check.ts",
    "live:pi-image-check": "bun scripts/live-pi-image-check.ts",
    "live:pi-image-intent-check": "bun scripts/live-pi-image-intent-check.ts",
    "live:pi-fallback": "PI_SMOKE_FORCE_OPENROUTER=1 bun scripts/live-pi-check.ts",
    "live:e2b-check": "bun scripts/live-e2b-check.ts",
    "live:browser-use-check": "bun scripts/live-browser-use-check.ts",
    "e2b:template:build": "bun e2b-template/build.ts",
    "e2b:template:promote": "bun e2b-template/promote.ts",
    "e2b:template:check": "bun e2b-template/check.ts",
    "e2b:release": "bun e2b-template/release.ts",
    "build:web": "bun scripts/build-web.ts"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/runner": "^2.0.3",
    "@tavily/core": "^0.7.8",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.2",
    "e2b": "2.46.0",
    "file-type": "22.0.2",
    "grammy": "^1.46.0",
    "pg": "^8.23.0",
    "playwright-core": "1.62.1",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bonkers-agency/grammy-test": "^0.1.3",
    "@types/bun": "1.4.2",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "bun-plugin-tailwind": "0.1.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.2"
}
